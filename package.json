{
  "name": "voicecloner",
  "version": "1.0.0",
  "description": "Clone your voice locally with Qwen3-TTS",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:ts": "tsc",
    "start": "npm run build:ts && electron .",
    "dist": "npm run build:ts && electron-builder",
    "dist:mac": "npm run build:ts && electron-builder --mac",
    "dist:win": "npm run build:ts && electron-builder --win",
    "dist:linux": "npm run build:ts && electron-builder --linux",
    "download-python": "bash scripts/download-python.sh"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "portfinder": "^1.0.32"
  }
}
